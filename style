:root {
  --primary: #2c3e50;
  --accent: #3498db;
  --success: #2ecc71;
  --danger: #e74c3c;
  --warning: #f1c40f;
  --bg: #f4f6f7;
  --card-bg: #ffffff;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: var(--bg);
  color: #333;
}

header {
  background-color: var(--primary);
  color: white;
  padding: 1rem;
}

.header-container {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

nav button {
  background: transparent;
  border: 1px solid white;
  color: white;
  padding: 8px 16px;
  margin-left: 8px;
  cursor: pointer;
  border-radius: 4px;
}

nav button.active {
  background: var(--accent);
  border-color: var(--accent);
}

.container {
  max-width: 1100px;
  margin: 20px auto;
  padding: 0 15px;
}

.aba-conteudo {
  display: none;
}

.aba-conteudo.active {
  display: block;
}

/* BUSCA E CARDS DO ACERVO */
.busca-box input {
  width: 100%;
  padding: 12px;
  font-size: 1rem;
  margin-bottom: 20px;
  border: 1px solid #ccc;
  border-radius: 6px;
}

.grid-livros {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
}

.card-livro {
  background: var(--card-bg);
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-livro img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 4px;
  margin-bottom: 10px;
}

.badge {
  display: inline-block;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: bold;
  color: white;
  margin-top: 5px;
}

.badge-disponivel { background-color: var(--success); }
.badge-esgotado { background-color: var(--danger); }

/* TABELAS E FORMULÁRIOS */
.card-form {
  background: white;
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  margin-bottom: 20px;
}

.form-grid {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 10px;
}

input, select, button {
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

button {
  background: var(--accent);
  color: white;
  border: none;
  cursor: pointer;
  font-weight: bold;
}

button:hover {
  opacity: 0.9;
}

.table-container {
  overflow-x: auto;
  background: white;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

table {
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 12px;
  text-align: left;
  border-bottom: 1px solid #eee;
}

th {
  background-color: #f8f9fa;
}

.btn-devolver {
  background-color: var(--success);
}

/* MODAIS */
.modal {
  display: none;
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.5);
  justify-content: center;
  align-items: center;
}

.modal-content {
  background: white;
  padding: 25px;
  border-radius: 8px;
  width: 90%;
  max-width: 450px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.close {
  align-self: flex-end;
  font-size: 1.5rem;
  cursor: pointer;
}

.hidden { display: none; }
