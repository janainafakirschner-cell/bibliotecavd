body {
  font-family: Arial, sans-serif;
  background-color: #f4f6f8;
  margin: 0;
  padding: 20px;
}

.container {
  max-width: 800px;
  margin: 0 auto;
  background: #ffffff;
  padding: 20px;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.hidden {
  display: none !important;
}

/* LAYOUT EM GRADE 2x2 PARA O PAINEL ADMIN */
.grid-admin {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  max-width: 450px;
  margin: 20px 0;
}

/* CARTOES ESTILIZADOS DO ADMIN */
.card-btn {
  background-color: #ffffff;
  border: 3px solid #000000;
  border-radius: 18px;
  height: 120px;
  font-size: 1.2em;
  font-weight: bold;
  color: #000000;
  cursor: pointer;
  transition: transform 0.1s ease, background-color 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-btn:hover {
  background-color: #f0f0f0;
  transform: scale(1.02);
}

.card-login {
  border: 1px solid #ccc;
  padding: 15px;
  border-radius: 6px;
}

.header-user {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid #ddd;
  padding-bottom: 10px;
}

.btn-sair {
  background-color: #d32f2f;
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 4px;
  cursor: pointer;
}

input[type="text"], input[type="password"], input[type="number"] {
  padding: 8px;
  border: 1px solid #ccc;
  border-radius: 4px;
  margin-top: 5px;
}

button {
  padding: 8px 14px;
  border-radius: 4px;
  cursor: pointer;
}
